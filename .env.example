# Environment Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/sourcing_mcp

# Server
MCP_SERVER_NAME=sourcing
LOG_LEVEL=INFO

# File Storage (for evidence uploads)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/sourcing-mcp/uploads
# STORAGE_BACKEND=s3
# STORAGE_S3_BUCKET=sourcing-evidence
# STORAGE_S3_REGION=us-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# External Services
# FX rates provider
FX_PROVIDER=mock
# FX_PROVIDER=exchangerate-api
# FX_API_KEY=

# Supplier verification services
VERIFICATION_PROVIDER=mock
# Business registry check
# QICHACHA_API_KEY=
# TIANYANCHA_API_KEY=

# Communication channels
# WeChat Work
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=

# Email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@sourcing.example.com

# Security
SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# Rate limiting
RFQ_DAILY_QUOTA=5
